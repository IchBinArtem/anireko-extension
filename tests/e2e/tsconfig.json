{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@widgets/*": ["widgets/*"],
      "@steps/*": ["steps/*"],
      "@support/*": ["support/*"]
    }
  },
  "include": ["**/*.ts"]
}
